#version 430 core
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D uPressureTex;
layout(binding = 1) uniform sampler2D uDivergenceTex;
layout(r32f, binding = 2) writeonly uniform image2D outPressureImg;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = textureSize(uPressureTex, 0);
    if (any(greaterThanEqual(coord, size))) return;

    // Sample adjacent pressure values
    float pL = texelFetch(uPressureTex, clamp(coord + ivec2(-1, 0),
                                               ivec2(0), size - 1), 0).x;
    float pR = texelFetch(uPressureTex, clamp(coord + ivec2(1, 0),
                                               ivec2(0), size - 1), 0).x;
    float pB = texelFetch(uPressureTex, clamp(coord + ivec2(0, -1),
                                               ivec2(0), size - 1), 0).x;
    float pT = texelFetch(uPressureTex, clamp(coord + ivec2(0, 1),
                                               ivec2(0), size - 1), 0).x;
    
    float div = texelFetch(uDivergenceTex, coord, 0).x;

    // Jacobi relaxation step formula
    float newPressure = (pL + pR + pB + pT - div) * 0.25;
    imageStore(outPressureImg, coord, vec4(newPressure, 0.0, 0.0, 0.0));
}
