#version 430 core
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D uVelocityTex;
layout(r32f, binding = 1) writeonly uniform image2D outDivergenceImg;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = textureSize(uVelocityTex, 0);
    if (any(greaterThanEqual(coord, size))) return;

    // Compute central difference derivatives of velocity components
    float vL = texelFetch(uVelocityTex, clamp(coord + ivec2(-1, 0),
                                               ivec2(0), size - 1), 0).x;
    float vR = texelFetch(uVelocityTex, clamp(coord + ivec2(1, 0),
                                               ivec2(0), size - 1), 0).x;
    float vB = texelFetch(uVelocityTex, clamp(coord + ivec2(0, -1),
                                               ivec2(0), size - 1), 0).y;
    float vT = texelFetch(uVelocityTex, clamp(coord + ivec2(0, 1),
                                               ivec2(0), size - 1), 0).y;

    float divergence = 0.5 * ((vR - vL) + (vT - vB));
    imageStore(outDivergenceImg, coord, vec4(divergence, 0.0, 0.0, 0.0));
}
